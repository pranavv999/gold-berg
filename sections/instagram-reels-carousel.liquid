{%- style -%}
  .instagram-reels-outer {
    background: #f7f7f8;
    padding: 24px !important;
    display: flex;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
  }

  .instagram-reels-container {
    background: #ffffff;
    border-radius: var(--container-radius, 24px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04);
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto;
    padding: 3.5rem 4rem;
    box-sizing: border-box;
  }

  .instagram-reels-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .instagram-reels-heading {
    font-family: var(--font-body-family), -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    color: #1d1d1f !important;
    margin: 0;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
  }

  .instagram-reels-carousel-wrapper {
    position: relative;
    overflow: hidden;
    width: 100%;
    touch-action: pan-y;
  }

  .instagram-reels-track {
    display: flex;
    gap: 1.8rem;
    width: max-content;
    will-change: transform;
  }

  .instagram-reel-card-item {
    width: 230px;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  @media screen and (max-width: 1024px) {
    .instagram-reel-card-item {
      width: 200px;
    }
  }

  @media screen and (max-width: 749px) {
    .instagram-reels-outer {
      padding: 16px 5px !important;
    }
    .instagram-reels-container {
      padding: 1.5rem !important;
      border-radius: var(--container-radius, 20px) !important;
    }
    .instagram-reels-header {
      margin-bottom: 2rem !important;
    }
    .instagram-reel-card-item {
      width: 165px;
    }
    .instagram-reels-track {
      gap: 1.2rem;
    }
  }

  .instagram-reel-card {
    display: block;
    position: relative;
    background: #000000;
    border-radius: 20px;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    width: 100%;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .instagram-reel-card video,
  .instagram-reel-card img,
  .instagram-reel-card iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: none;
    pointer-events: none;
  }

  .instagram-reel-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px 12px;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 100%);
    color: #ffffff;
    font-size: 11px;
    font-weight: 500;
    pointer-events: none;
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 5;
  }

  .instagram-reel-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    fill: currentColor;
  }

  /* ARROWS */
  .instagram-reels-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 2rem;
  }

  .instagram-reels-arrow {
    background: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #1d1d1f;
    transition: background 0.2s, border-color 0.2s;
  }

  .instagram-reels-arrow:hover {
    background: #f7f7f8;
    border-color: #d1d1d6;
  }
{%- endstyle -%}

<div class="instagram-reels-outer" id="InstagramReels-{{ section.id }}">
  <div class="instagram-reels-container" style="--container-radius: {{ section.settings.container_radius }}px;">
    {%- if section.settings.heading != blank -%}
      <div class="instagram-reels-header">
        <h2 class="instagram-reels-heading">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div
      class="instagram-reels-carousel-wrapper"
      role="region"
      aria-label="Instagram Reels Carousel"
      data-autoplay="{{ section.settings.autoplay }}"
      data-interval="{{ section.settings.autoplay_interval }}"
    >
      <div class="instagram-reels-track" id="ReelsTrack-{{ section.id }}">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="instagram-reel-card-item" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" target="_blank" rel="noopener" class="instagram-reel-card">
              {%- else -%}
                <div class="instagram-reel-card">
              {%- endif -%}

                {%- if block.settings.video != blank -%}
                  {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '600x' }}
                {%- elsif block.settings.video_url != blank -%}
                  <video
                    src="{{ block.settings.video_url }}"
                    {% if block.settings.poster_image != blank %}poster="{{ block.settings.poster_image | image_url: width: 600 }}"{% endif %}
                    autoplay
                    loop
                    muted
                    playsinline
                  ></video>
                {%- elsif block.settings.poster_image != blank -%}
                  <img
                    src="{{ block.settings.poster_image | image_url: width: 600 }}"
                    alt="{{ block.settings.caption | default: 'Instagram Reel' | escape }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <div style="width:100%;height:100%;background:#1d1d1f;display:flex;align-items:center;justify-content:center;color:#8e8e93;">
                    <svg class="instagram-reel-icon" style="width:32px;height:32px;" viewBox="0 0 24 24">
