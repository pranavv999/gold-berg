                    </svg>
                  </div>
                {%- endif -%}

                {%- if block.settings.caption != blank -%}
                  <div class="instagram-reel-overlay">
                    <svg class="instagram-reel-icon" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                    <span>{{ block.settings.caption | escape }}</span>
                  </div>
                {%- endif -%}

              {%- if block.settings.link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for j in (1..5) -%}
            <div class="instagram-reel-card-item">
              <div class="instagram-reel-card">
                <div style="width:100%;height:100%;background:#1d1d1f;display:flex;align-items:center;justify-content:center;color:#8e8e93;">
                  <svg class="instagram-reel-icon" style="width:36px;height:36px;" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if section.settings.show_arrows -%}
        <div class="instagram-reels-controls">
          <button type="button" class="instagram-reels-arrow prev" id="ReelsPrev-{{ section.id }}" aria-label="Previous reel">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <button type="button" class="instagram-reels-arrow next" id="ReelsNext-{{ section.id }}" aria-label="Next reel">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    const sectionId = {{ section.id | json }};
    const track = document.getElementById('ReelsTrack-' + sectionId);
    if (!track) return;

    const wrapper = track.parentElement;
    const isAutoplay = wrapper.getAttribute('data-autoplay') === 'true';
    const intervalMs = parseInt(wrapper.getAttribute('data-interval') || '5000', 10);
    const speed = Math.max(0.5, 3800 / intervalMs);

    const originalItems = Array.from(track.children).filter(el => !el.classList.contains('is-clone'));
    if (originalItems.length === 0) return;

    function getOriginalWidth() {
      let totalWidth = 0;
      const gap = parseFloat(window.getComputedStyle(track).gap || '20');
      originalItems.forEach(el => {
        totalWidth += el.offsetWidth + gap;
      });
      return totalWidth;
    }

    let originalWidth = 0;

    function initClones() {
      // Clear old clones if any
      Array.from(track.children).forEach(child => {
        if (child.classList.contains('is-clone')) child.remove();
      });

      originalWidth = getOriginalWidth();
      if (originalWidth <= 0) return;

      // Ensure track length is at least (originalWidth + wrapper.clientWidth + 500)
      const requiredWidth = originalWidth + wrapper.clientWidth + 500;
      let safetyCounter = 0;
      while (track.scrollWidth < requiredWidth && safetyCounter < 15) {
        originalItems.forEach(item => {
          const clone = item.cloneNode(true);
          clone.removeAttribute('data-block-id');
          clone.removeAttribute('id');
          clone.classList.add('is-clone');
          track.appendChild(clone);
        });
        safetyCounter++;
      }
    }

    initClones();

    // Re-verify after load
    window.addEventListener('load', () => {
      initClones();
    });

    let animationFrame = null;
    let currentX = 0;
    let isPaused = false;

    function animate() {
      if (isAutoplay && !isPaused && originalWidth > 0) {
        currentX -= speed;
        if (Math.abs(currentX) >= originalWidth) {
          currentX += originalWidth;
        }
        track.style.transform = `translate3d(${currentX}px, 0, 0)`;
      }
      animationFrame = requestAnimationFrame(animate);
    }

    // Pause on hover
    wrapper.addEventListener('mouseenter', () => { isPaused = true; });
    wrapper.addEventListener('mouseleave', () => { isPaused = false; });

    // Touch swipe support
    let touchStartX = 0;
    let touchCurrentX = 0;
    let isTouching = false;

    wrapper.addEventListener('touchstart', (e) => {
      isTouching = true;
      isPaused = true;
      touchStartX = e.touches[0].clientX;
    }, { passive: true });

    wrapper.addEventListener('touchmove', (e) => {
      if (!isTouching || originalWidth <= 0) return;
      touchCurrentX = e.touches[0].clientX;
      const diff = touchCurrentX - touchStartX;
      touchStartX = touchCurrentX;
      currentX += diff;

      if (currentX > 0) currentX -= originalWidth;
      if (Math.abs(currentX) >= originalWidth) currentX += originalWidth;

      track.style.transform = `translate3d(${currentX}px, 0, 0)`;
    }, { passive: true });

    wrapper.addEventListener('touchend', () => {
      isTouching = false;
      isPaused = false;
    });

    const prevBtn = document.getElementById('ReelsPrev-' + sectionId);
    const nextBtn = document.getElementById('ReelsNext-' + sectionId);

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        const item = originalItems[0];
        if (item && originalWidth > 0) {
          const shift = item.offsetWidth + 20;
          currentX += shift;
          if (currentX > 0) currentX -= originalWidth;
          track.style.transform = `translate3d(${currentX}px, 0, 0)`;
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const item = originalItems[0];
        if (item && originalWidth > 0) {
          const shift = item.offsetWidth + 20;
          currentX -= shift;
          if (Math.abs(currentX) >= originalWidth) currentX += originalWidth;
          track.style.transform = `translate3d(${currentX}px, 0, 0)`;
        }
      });
    }

    window.addEventListener('resize', () => {
      initClones();
    });

    // Theme Editor Live Block Selection
    if (Shopify && Shopify.designMode) {
      document.addEventListener('shopify:block:select', (evt) => {
        if (evt.detail.sectionId === sectionId) {
          isPaused = true;
        }
      });

      document.addEventListener('shopify:block:deselect', (evt) => {
        if (evt.detail.sectionId === sectionId) {
          isPaused = false;
        }
      });
    }

    animate();
  })();
</script>

{% schema %}
{
  "name": "Instagram Reels Carousel",
  "tag": "section",
  "class": "section-instagram-reels-carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "INSTAGRAM REELS"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable continuous smooth scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 1000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "label": "Scroll speed (lower is faster)",
      "default": 5000
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": false
    },
    {
      "type": "range",
      "id": "container_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24,
      "label": "Container corner radius"
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel / Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video File (Shopify Database)"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Direct MP4 Video URL (Fallback)"
        },
        {
          "type": "image_picker",
          "id": "poster_image",
          "label": "Poster / Thumbnail Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Reel Link (Redirect URL)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption / Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Reels Carousel",
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}
