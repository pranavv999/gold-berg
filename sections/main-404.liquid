<style type="text/css">
  .custom-404-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-top: clamp(75px, 8vh, 100px);
    padding-bottom: clamp(50px, 8vh, 90px);
    padding-left: 24px;
    padding-right: 24px;
    min-height: 45vh;
    box-sizing: border-box;
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .custom-404-container {
      padding-left: 12px;
      padding-right: 12px;
    }
  }

  .custom-404-container .subtext {
    font-size: clamp(80px, 15vw, 150px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0 0 1.2rem 0;
    color: currentColor;
  }

  .custom-404-container .title {
    font-family: var(--font-heading-family);
    font-size: clamp(22px, 3.5vw, 34px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.02em;
    margin: 0 0 2rem 0;
  }

  .custom-404-container .button {
    margin-top: 0.5rem;
  }
</style>

<div class="custom-404-container page-width center">
  <p class="subtext">
    {{ 'templates.404.subtext' | t }}
  </p>
  <h1 class="title">
    {{ 'templates.404.title' | t }}
  </h1>
  <a href="{{ routes.all_products_collection_url }}" class="button">
    {{ 'general.continue_shopping' | t }}
  </a>
</div>
