<script>
  // Global delegated click handler for Variant Pills, Tabs, and Size Guide
  document.addEventListener('click', function (e) {
    // 1. Variant Pill Selection
    const pill = e.target.closest('.variant-pill');
    if (pill) {
      const form = pill.closest('form') || document.getElementById('product-form-custom');
      if (form) {
        const hiddenIdInput = form.querySelector('input[name="id"]');
        const priceElem = form.querySelector('.product-info-price');
        const comparePriceElem = form.querySelector('.product-compare-price');
        const pills = form.querySelectorAll('.variant-pill');

        pills.forEach((p) => p.classList.remove('selected'));
        pill.classList.add('selected');

        const variantId = pill.getAttribute('data-variant-id');
        if (hiddenIdInput && variantId) {
          hiddenIdInput.value = variantId;
        }

        const price = pill.getAttribute('data-price');
        const comparePrice = pill.getAttribute('data-compare-price');
        if (priceElem && price) {
          priceElem.textContent = price;
        }
        if (comparePriceElem) {
          if (comparePrice) {
            comparePriceElem.textContent = comparePrice;
            comparePriceElem.style.display = 'inline';
          } else {
            comparePriceElem.style.display = 'none';
          }
        }
      }
      return;
    }

    // 2. Tab Switching
    const tabBtn = e.target.closest('.tab-header-btn');
    if (tabBtn) {
      const tabId = tabBtn.getAttribute('data-tab');
      if (tabId) {
        const container = tabBtn.closest('.product-info-card') || document;
        const tabBtns = container.querySelectorAll('.tab-header-btn');
        const tabPanes = container.querySelectorAll('.tab-pane');

        tabBtns.forEach((b) => b.classList.remove('active'));
        tabBtn.classList.add('active');

        tabPanes.forEach((pane) => {
          if (pane.id === `tab-${tabId}`) {
            pane.classList.add('active');
          } else {
            pane.classList.remove('active');
          }
        });
      }
      return;
    }

    // 3. Video Sound Toggle (Mute/Unmute)
    const soundBtn = e.target.closest('.product-video-sound-toggle');
    if (soundBtn) {
      const card = soundBtn.closest('.product-video-card');
      if (card) {
        const video = card.querySelector('video');
        if (video) {
          video.muted = !video.muted;
          const mutedIcon = soundBtn.querySelector('.sound-icon-muted');
          const unmutedIcon = soundBtn.querySelector('.sound-icon-unmuted');
          if (video.muted) {
            if (mutedIcon) mutedIcon.style.display = 'block';
            if (unmutedIcon) unmutedIcon.style.display = 'none';
          } else {
            if (mutedIcon) mutedIcon.style.display = 'none';
            if (unmutedIcon) unmutedIcon.style.display = 'block';
          }
        }
      }
      return;
    }

    // 3. Size Guide Trigger
    const sizeGuideBtn = e.target.closest('.size-guide-btn');
    if (sizeGuideBtn) {
      e.preventDefault();
      if (window.SmartSize && typeof window.SmartSize.open === 'function') {
        window.SmartSize.open();
        return;
      }
      const appTrigger = document.querySelector(
        '.product-app-block-wrapper a, .product-app-block-wrapper button, .smartsize-trigger-link, [data-smartsize-chart], a[href*="smartsize"], .smartsize-block a'
      );
      if (appTrigger && appTrigger !== sizeGuideBtn) {
        appTrigger.click();
        return;
      }
      const modal = document.getElementById('size-guide-modal');
      if (modal) {
        modal.classList.add('active');
      }
      return;
    }

    // 4. SmartSize Close Buttons
    const closeElem = e.target.closest(
      '[class*="close"], [class*="dismiss"], [aria-label*="close" i], [aria-label*="Close"]'
    );
    if (closeElem && closeElem.closest('[class*="smartsize"], [id*="smartsize"]')) {
      if (window.SmartSize && typeof window.SmartSize.close === 'function') {
        window.SmartSize.close();
      } else {
        document.querySelectorAll('[class*="smartsize"], [id*="smartsize"]').forEach((m) => {
          m.style.display = 'none';
          m.classList.remove('active');
        });
      }
    }
  });

  // Global delegated submit handler for AJAX Add to Bag
  document.addEventListener('submit', function (e) {
    const form = e.target.closest('#product-form-custom');
    if (!form) return;

    e.preventDefault();
    e.stopPropagation();

    const submitBtn = form.querySelector('button[name="add"]') || form.querySelector('button[type="submit"]');
    let originalBtnHtml = '';
    if (submitBtn) {
      if (submitBtn.disabled || submitBtn.getAttribute('aria-disabled') === 'true') return;
      submitBtn.disabled = true;
      submitBtn.setAttribute('aria-disabled', 'true');
      originalBtnHtml = submitBtn.innerHTML;
      submitBtn.innerHTML = '<span>ADDING...</span>';
    }

    const formData = new FormData(form);
    const cartDrawer = document.querySelector('cart-drawer');
    if (cartDrawer) {
      cartDrawer.classList.remove('is-empty');
    }

    if (cartDrawer && typeof cartDrawer.getSectionsToRender === 'function') {
      const sections = cartDrawer.getSectionsToRender().map((s) => s.id);
      formData.append('sections', sections.join(','));
      formData.append('sections_url', window.location.pathname);
    } else {
      formData.append('sections', 'cart-drawer,cart-icon-bubble');
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'X-Requested-With': 'XMLHttpRequest',
      },
      body: formData,
    })
      .then((res) => res.json())
      .then((response) => {
        if (response.status) {
          alert(response.description || response.message || 'Error adding to bag');
          if (submitBtn) {
            submitBtn.innerHTML = originalBtnHtml;
            submitBtn.disabled = false;
            submitBtn.removeAttribute('aria-disabled');
          }
          return;
        }

        if (submitBtn) {
          submitBtn.innerHTML = '<span>ADDED TO BAG</span>';
        }

        // Refresh cart drawer contents dynamically and open drawer
        if (cartDrawer) {
          cartDrawer.classList.remove('is-empty');
          if (typeof cartDrawer.renderContents === 'function') {
            cartDrawer.renderContents(response);
          } else if (typeof cartDrawer.open === 'function') {
            cartDrawer.open();
          } else {
            cartDrawer.setAttribute('open', '');
          }
        }
      })
      .catch((err) => {
        console.error('Error adding to cart:', err);
        if (submitBtn) {
          submitBtn.innerHTML = originalBtnHtml;
          submitBtn.disabled = false;
          submitBtn.removeAttribute('aria-disabled');
        }
      })
      .finally(() => {
        setTimeout(() => {
          if (submitBtn) {
            submitBtn.innerHTML = originalBtnHtml;
            submitBtn.disabled = false;
            submitBtn.removeAttribute('aria-disabled');
          }
        }, 1500);
      });
  });

  // Mobile media slider dots sync logic
  function initMobileMediaSlider() {
    const mobileTrack = document.querySelector('.mobile-media-track');
    const dots = document.querySelectorAll('.mobile-dot');

    if (!mobileTrack || dots.length === 0) return;

    mobileTrack.addEventListener('scroll', () => {
      const scrollPosition = mobileTrack.scrollLeft;
      const slideWidth = mobileTrack.offsetWidth;
      if (slideWidth === 0) return;

      const activeIndex = Math.round(scrollPosition / slideWidth);

      dots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        const slideWidth = mobileTrack.offsetWidth;
        mobileTrack.scrollTo({
          left: slideWidth * index,
          behavior: 'smooth',
        });
      });
    });
  }

  // Format SmartSize links on trigger load
  function formatSmartSizeLinks() {
    const smartLinks = document.querySelectorAll(
      '.variant-selector-header .product-app-block-wrapper a, .variant-selector-header .product-app-block-wrapper button, .variant-selector-header .product-app-block-wrapper span, .variant-selector-header .smartsize-trigger-link, .variant-selector-header [data-smartsize-chart]'
    );
    smartLinks.forEach((link) => {
      if (link.tagName === 'DIV' || link.classList.contains('product-app-block-wrapper')) return;
      link.classList.add('size-guide-btn');
      link.style.textDecoration = 'none';
      link.style.borderRadius = '12px';
      link.style.backgroundColor = '#f2f2f4';
      link.style.color = '#6e6e73';
      link.style.padding = '6px 12px';
      link.style.fontSize = '10px';
      link.style.fontWeight = '500';
      link.style.fontFamily = 'inherit';
      link.style.display = 'inline-flex';
      link.style.alignItems = 'center';
      link.style.justifyContent = 'center';
    });
  }

  // Lazy Stream & Auto-Play Video on Scroll via IntersectionObserver
  function initLazyVideoShowcase() {
    const videoContainers = document.querySelectorAll('[data-lazy-video-container]');
    if ('IntersectionObserver' in window && videoContainers.length > 0) {
      const videoObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const video = entry.target.querySelector('video');
            if (!video) return;

            if (entry.isIntersecting) {
              const source = video.querySelector('source[data-src]');
              if (source && !source.src) {
                source.src = source.getAttribute('data-src');
                video.load();
              }
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          });
        },
        {
          rootMargin: '100px 0px',
          threshold: 0.1,
        }
      );

      videoContainers.forEach((container) => videoObserver.observe(container));
    }
  }

  // Initialize features on DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initMobileMediaSlider();
      formatSmartSizeLinks();
      initLazyVideoShowcase();
      setTimeout(formatSmartSizeLinks, 1000);
    });
  } else {
    initMobileMediaSlider();
    formatSmartSizeLinks();
    initLazyVideoShowcase();
    setTimeout(formatSmartSizeLinks, 1000);
  }
</script>

