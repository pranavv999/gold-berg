{
  "name": "t:sections.footer.name",
  "type": "footer",
  "sections": {
    "infinite_marquee": {
      "type": "infinite-marquee",
      "settings": {
        "marquee_text": "FREE WORLDWIDE SHIPPING • SOBER ANIMAL • PREMIUM OVERSIZED FIT • NEW DROPS LIVE",
        "separator_text": "•",
        "text_color": "#ffffff",
        "background_color": "#000000",
        "font_size_desktop": 14,
        "font_size_mobile": 12,
        "font_weight": "500",
        "letter_spacing": 2,
        "padding_vertical_desktop": 14,
        "padding_vertical_mobile": 10,
        "gap_between_items": 40,
        "speed": 25,
        "direction": "normal",
        "pause_on_hover": true
      }
    },
    "footer": {
      "type": "footer",
      "blocks": {
        "social_instagram": {
          "type": "social_link",
          "settings": {
            "platform": "instagram",
            "url": "https://instagram.com"
          }
        },
        "social_x": {
          "type": "social_link",
          "settings": {
            "platform": "x",
            "url": "https://x.com"
          }
        },
        "social_youtube": {
          "type": "social_link",
          "settings": {
            "platform": "youtube",
            "url": "https://youtube.com"
          }
        }
      },
      "block_order": [
        "social_instagram",
        "social_x",
        "social_youtube"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "newsletter_enable": true,
        "newsletter_heading": "SUBSCRIBE TO OUR NEWSLETTER",
        "show_footer_logo": true,
        "enable_follow_on_shop": true,
        "show_social": true,
        "enable_country_selector": true,
        "enable_language_selector": true,
        "payment_enable": true,
        "show_policy": true,
        "margin_top": 0,
        "padding_top": 36,
        "padding_bottom": 36,
        "padding_top_desktop": 15,
        "padding_top_mobile": 15
      }
    }
  },
  "order": [
    "infinite_marquee",
    "footer"
  ]
