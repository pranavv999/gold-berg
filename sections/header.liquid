<script>
  window.toggleCustomMegaMenu = function(e) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    var wrapper = document.getElementById('custom-glass-header-wrapper');
    if (wrapper) {
      wrapper.classList.toggle('mega-menu-open');
    }
  };

  (function() {
    function initGlassHeader() {
      var wrapper = document.getElementById('custom-glass-header-wrapper');
      if (!wrapper) return;

      function checkScroll() {
        {%- if has_scroll_effect -%}
          var sy = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0;
          if (sy > 5) {
            wrapper.classList.add('is-scrolled');
          } else {
            wrapper.classList.remove('is-scrolled');
          }
        {%- else -%}
          wrapper.classList.add('is-scrolled');
        {%- endif -%}
      }

      checkScroll();
      window.addEventListener('scroll', checkScroll, { passive: true });
      window.addEventListener('resize', checkScroll, { passive: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGlassHeader);
    } else {
      initGlassHeader();
    }

    document.addEventListener('shopify:section:load', initGlassHeader);

    document.addEventListener('click', function(e) {
      var wrapper = document.getElementById('custom-glass-header-wrapper');
      if (!wrapper) return;

      var btn = e.target.closest('#header-hamburger-menu-btn, .header-hamburger-btn');
      if (btn) {
        return; // Handled by inline onclick="toggleCustomMegaMenu(event)"
      }

      if (wrapper.classList.contains('mega-menu-open') && !wrapper.contains(e.target)) {
        wrapper.classList.remove('mega-menu-open');
      }

      var subHeader = e.target.closest('.mega-menu-sub-header');
      if (subHeader && window.innerWidth < 750) {
        e.preventDefault();
        e.stopPropagation();

        var currentSubGroup = subHeader.closest('.mega-menu-sub-group');
        if (!currentSubGroup) return;

        var isAlreadyOpen = currentSubGroup.classList.contains('is-open');

        document.querySelectorAll('.mega-menu-sub-group.is-open').forEach(function(group) {
          group.classList.remove('is-open');
          var toggleBtn = group.querySelector('.mega-menu-toggle-btn');
          if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
        });

        if (!isAlreadyOpen) {
          currentSubGroup.classList.add('is-open');
          var toggleBtn = currentSubGroup.querySelector('.mega-menu-toggle-btn');
          if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
        }
      }
    });

    document.addEventListener('keydown', function(e) {
      var wrapper = document.getElementById('custom-glass-header-wrapper');
      if (e.key === 'Escape' && wrapper && wrapper.classList.contains('mega-menu-open')) {
        wrapper.classList.remove('mega-menu-open');
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Custom Glass Header",
  "class": "section-header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "default": 150,
      "unit": "px",
      "label": "Logo width"
    },
    {
      "type": "range",
      "id": "glass_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 80,
      "unit": "%",
      "label": "Glass Opacity"
    },
    {
      "type": "checkbox",
      "id": "scrolled_effect",
      "label": "scrolled-effect",
      "default": true,
      "info": "ON: Navbar expands to browser edges at top and shrinks when scrolled. OFF: Navbar remains permanently shrinked & floating away from browser edges at all times with no scroll effect."
    },
    {
      "type": "range",
      "id": "glass_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px",
      "label": "Scrolled Border Radius"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Mega Menu Navigation",
      "default": "main-menu",
      "info": "Select a 3-level menu (Main Category -> Sub Category -> Collection Name) created in Shopify Admin -> Navigation."
    }
  ],
  "blocks": [
    {
      "type": "main_category",
      "name": "Main Category Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Main Category Title",
          "default": "Top wear"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Main Category Link"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Sub Categories & Collections Menu",
          "info": "Nested menu containing Sub Categories (Level 1) and Collection Links (Level 2)."
        }
      ]
    }
  ]
}
{% endschema %}
