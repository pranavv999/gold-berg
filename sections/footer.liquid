{% comment %}
  Custom Floating Footer Section for SOBER ANIMAL with Newsletter, Social Icons, 2 Nav Columns & Watermark
{% endcomment %}

{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="custom-footer-section">
  <div class="custom-footer-outer-wrapper">
    {% comment %} Floating Inner White Footer Card Container {% endcomment %}
    <div class="custom-footer-card">
      <div class="custom-footer-content-grid">
        {% comment %} Left Column: Newsletter & Social Links {% endcomment %}
        <div class="custom-footer-left">
          <div class="custom-footer-newsletter">
            {%- if section.settings.newsletter_heading != blank -%}
              <h2 class="footer-newsletter-heading">
                {{ section.settings.newsletter_heading | escape }}
              </h2>
            {%- else -%}
              <h2 class="footer-newsletter-heading">SUBSCRIBE TO OUR NEWSLETTER</h2>
            {%- endif -%}

            {%- if section.settings.newsletter_subtext != blank -%}
              <p class="footer-newsletter-subtext">{{ section.settings.newsletter_subtext | escape }}</p>
            {%- endif -%}

            {%- form 'customer', id: 'FooterNewsletterForm', class: 'footer-newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="newsletter-form__field-wrapper">
                <div class="field">
                  <input
                    id="NewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="field__input newsletter-field__input"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="FooterNewsletter-error"
                    {% elsif form.posted_successfully? %}
                      aria-describedby="FooterNewsletter-success"
                    {% endif %}
                    placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email address' }}"
                    required
                  >
                  <label class="field__label visually-hidden" for="NewsletterForm--{{ section.id }}">
                    {{ 'newsletter.label' | t | default: 'Email' }}
                  </label>
                  <button
                    type="submit"
                    class="newsletter-form__button"
                    name="commit"
                    id="Subscribe"
                    aria-label="{{ 'newsletter.button_label' | t | default: 'Subscribe' }}"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </button>
                </div>
                {%- if form.errors -%}
                  <small class="newsletter-form__message form__message" id="FooterNewsletter-error">
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </small>
                {%- endif -%}
              </div>
              {%- if form.posted_successfully? -%}
                <h3
                  class="newsletter-form__message newsletter-form__message--success form__message"
                  id="FooterNewsletter-success"
                  tabindex="-1"
                  autofocus
                >
                  {{- 'newsletter.success' | t | default: 'Thanks for subscribing!' -}}
                </h3>
              {%- endif -%}
            {%- endform -%}
          </div>

          {% comment %} Social Icons Below Newsletter {% endcomment %}
          <div class="custom-footer-social">
            {%- liquid
              assign social_blocks = section.blocks | where: 'type', 'social_link'
            -%}
            {%- if social_blocks.size > 0 -%}
              <div class="footer-social-list">
                {%- for block in social_blocks -%}
                  {%- assign platform = block.settings.platform | default: 'instagram' -%}
                  {%- assign platform_title = block.settings.title | default: platform | capitalize -%}
                  <a
                    href="{{ block.settings.url | default: '#' }}"
                    class="footer-social-icon-link"
                    target="_blank"
                    rel="noopener"
                    title="{{ platform_title | escape }}"
                    aria-label="{{ platform_title | escape }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 60 | image_tag: class: 'footer-social-logo-img', alt: platform_title }}
                    {%- else -%}
                      {%- case platform -%}
                        {%- when 'instagram' -%}
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                        {%- when 'x' -%}
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        {%- when 'youtube' -%}
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
                        {%- when 'tiktok' -%}
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
                        {%- when 'facebook' -%}
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
                        {%- when 'linkedin' -%}
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                        {%- when 'reddit' -%}
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.11 3.11 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.363.043-.538A1.758 1.758 0 0 1 4 12.002c0-.968.786-1.754 1.754-1.754.463 0 .88.18 1.186.476 1.186-.847 2.825-1.405 4.636-1.484l.905-4.238 3.2.677a1.247 1.247 0 0 1 1.33-.935zm-8.895 7.82c-.63 0-1.14.51-1.14 1.14 0 .63.51 1.14 1.14 1.14.63 0 1.14-.51 1.14-1.14 0-.63-.51-1.14-1.14-1.14zm7.77 0c-.63 0-1.14.51-1.14 1.14 0 .63.51 1.14 1.14 1.14.63 0 1.14-.51 1.14-1.14 0-.63-.51-1.14-1.14-1.14zm-6.756 3.652c-.085.085-.085.223 0 .308.77.77 2.016 1.05 3.037 1.05 1.02 0 2.267-.28 3.037-1.05a.217.217 0 0 0 0-.308.217.217 0 0 0-.308 0c-.634.634-1.722.882-2.729.882-1.008 0-2.096-.248-2.73-.882a.217.217 0 0 0-.307 0z"/></svg>
                        {%- when 'pinterest' -%}
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.367 18.62 0 12.017 0z"/></svg>
                        {%- when 'threads' -%}
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.186 24.004c-3.15 0-5.697-1.026-7.575-3.051-1.89-2.04-2.847-4.865-2.847-8.398 0-3.565.967-6.42 2.876-8.489C6.56 1.983 9.13.948 12.285.948c3.21 0 5.79 1.066 7.671 3.17 1.83 2.051 2.755 4.887 2.755 8.43 0 .425-.015.82-.045 1.185h-3.48c.015-.315.03-.66.03-.99 0-2.475-.63-4.425-1.89-5.85-1.26-1.425-2.955-2.145-5.085-2.145-2.175 0-3.9.72-5.175 2.16-1.275 1.44-1.92 3.42-1.92 5.94 0 2.505.645 4.47 1.935 5.895 1.29 1.425 3.015 2.145 5.175 2.145 2.07 0 3.735-.675 4.965-2.025.75-.825 1.26-1.875 1.53-3.15h-6.48v-3.375h9.84v2.025c0 2.85-1.02 5.175-3.06 6.975-2.04 1.8-4.665 2.7-7.875 2.7z"/></svg>
                        {%- when 'whatsapp' -%}
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                        {%- else -%}
                          <span class="footer-social-fallback-icon">{{ platform_title | slice: 0, 1 | upcase }}</span>
                      {%- endcase -%}
                    {%- endif -%}
                  </a>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="footer-social-list">
                {%- if settings.social_instagram_link != blank or settings.social_twitter_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank or settings.social_facebook_link != blank -%}
                  {%- if settings.social_instagram_link != blank -%}
                    <a href="{{ settings.social_instagram_link }}" class="footer-social-icon-link" target="_blank" rel="noopener" aria-label="Instagram">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                    </a>
                  {%- endif -%}
                  {%- if settings.social_twitter_link != blank -%}
                    <a href="{{ settings.social_twitter_link }}" class="footer-social-icon-link" target="_blank" rel="noopener" aria-label="X (Twitter)">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    </a>
                  {%- endif -%}
                  {%- if settings.social_youtube_link != blank -%}
                    <a href="{{ settings.social_youtube_link }}" class="footer-social-icon-link" target="_blank" rel="noopener" aria-label="YouTube">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
                    </a>
                  {%- endif -%}
                  {%- if settings.social_tiktok_link != blank -%}
                    <a href="{{ settings.social_tiktok_link }}" class="footer-social-icon-link" target="_blank" rel="noopener" aria-label="TikTok">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
                    </a>
                  {%- endif -%}
                  {%- if settings.social_facebook_link != blank -%}
                    <a href="{{ settings.social_facebook_link }}" class="footer-social-icon-link" target="_blank" rel="noopener" aria-label="Facebook">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
                    </a>
                  {%- endif -%}
                {%- else -%}
                  <a href="https://instagram.com" class="footer-social-icon-link" target="_blank" rel="noopener" aria-label="Instagram">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                  </a>
                  <a href="https://x.com" class="footer-social-icon-link" target="_blank" rel="noopener" aria-label="X (Twitter)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  </a>
                  <a href="https://youtube.com" class="footer-social-icon-link" target="_blank" rel="noopener" aria-label="YouTube">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>

        {% comment %} Optional Middle Column: Footer Logo {% endcomment %}
        {%- if section.settings.show_footer_logo and section.settings.footer_logo != blank -%}
          {%- assign logo_width_style = 'max-width: ' | append: section.settings.footer_logo_width | append: 'px;' -%}
          <div class="custom-footer-middle-logo">
            <a href="{{ routes.root_url }}" class="custom-footer-logo-link" aria-label="{{ shop.name }}">
              {{
                section.settings.footer_logo
                | image_url: width: 600
                | image_tag:
                  class: 'custom-footer-logo-img',
                  style: logo_width_style,
                  alt: shop.name
              }}
            </a>
          </div>
        {%- endif -%}

        {% comment %} Right Column: 2 Navigation Columns {% endcomment %}
        <div class="custom-footer-right">
          {% comment %} Column A: Customer Support {% endcomment %}
          <div class="custom-footer-nav-col">
            <h3 class="footer-nav-heading">
              {{ section.settings.col1_heading | default: 'Customer Support' }}
            </h3>
            <ul class="footer-nav-list">
              {%- if section.settings.col1_menu != blank and section.settings.col1_menu.links.size > 0 -%}
                {%- for link in section.settings.col1_menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="footer-nav-link">{{ link.title | escape }}</a>
                  </li>
                {%- endfor -%}
              {%- else -%}
                <li><a href="https://panel.shipmozo.com/track-order" class="footer-nav-link" target="_blank" rel="noopener">Track Order</a></li>
                <li><a href="{{ shop.policies.contact_information.url | default: '/policies/contact-information' }}" class="footer-nav-link">Contact Us</a></li>
                <li><a href="/apps/return_prime" class="footer-nav-link">Return / Exchange</a></li>
                <li><a href="/pages/contact" class="footer-nav-link">Get Hired</a></li>
              {%- endif -%}
            </ul>
          </div>

          {% comment %} Column B: Information & Policies {% endcomment %}
          <div class="custom-footer-nav-col">
            <h3 class="footer-nav-heading">
              {{ section.settings.col2_heading | default: 'Information & Policies' }}
            </h3>
            <ul class="footer-nav-list">
              {%- if section.settings.col2_menu != blank and section.settings.col2_menu.links.size > 0 -%}
                {%- for link in section.settings.col2_menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="footer-nav-link">{{ link.title | escape }}</a>
                  </li>
                {%- endfor -%}
              {%- else -%}
                <li><a href="/pages/about" class="footer-nav-link">About Us</a></li>
                <li><a href="/policies/terms-of-service" class="footer-nav-link">Terms</a></li>
                <li><a href="/policies/privacy-policy" class="footer-nav-link">Privacy Policy</a></li>
                <li><a href="/policies/shipping-policy" class="footer-nav-link">Shipping Policy</a></li>
                <li><a href="/policies/refund-policy" class="footer-nav-link">Refund Policy</a></li>
              {%- endif -%}
            </ul>
          </div>
        </div>
      </div>

      {% comment %} Separator Line & Copyright Bar {% endcomment %}
      <div class="custom-footer-bottom-bar">
        <div class="footer-copyright-text">
          {{ section.settings.copyright_text | default: '© 2026 SOBER ANIMAL. All rights reserved.' }}
        </div>
      </div>
    </div>

    {% comment %} Giant Half-Cut Watermark Text at Bottom ("Sober") {% endcomment %}
    <div class="custom-footer-watermark-wrapper" aria-hidden="true">
      <span class="custom-footer-watermark-text">
        {{ section.settings.watermark_text | default: 'Sober' }}
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "section-footer",
  "settings": [
    {
      "type": "header",
      "content": "Footer Brand Logo"
    },
    {
      "type": "checkbox",
      "id": "show_footer_logo",
      "label": "Show logo in footer",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer logo image"
    },
    {
      "type": "range",
      "id": "footer_logo_width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Footer logo width",
      "default": 160
    },
    {
      "type": "header",
      "content": "Newsletter Section"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "SUBSCRIBE TO OUR NEWSLETTER"
    },
    {
      "type": "text",
      "id": "newsletter_subtext",
      "label": "Newsletter Subtext"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Newsletter Field Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "header",
      "content": "Navigation Columns"
    },
    {
      "type": "text",
      "id": "col1_heading",
      "label": "Column A Heading",
      "default": "Customer Support"
    },
    {
      "type": "link_list",
      "id": "col1_menu",
      "label": "Column A Menu"
    },
    {
      "type": "text",
      "id": "col2_heading",
      "label": "Column B Heading",
      "default": "Information & Policies"
    },
    {
      "type": "link_list",
      "id": "col2_menu",
      "label": "Column B Menu"
    },
    {
      "type": "header",
      "content": "Bottom Copyright Bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "© 2026 SOBER ANIMAL. All rights reserved."
    },
    {
      "type": "header",
      "content": "Giant Watermark Text"
    },
    {
      "type": "text",
      "id": "watermark_text",
      "label": "Watermark Text",
      "default": "Sober"
    }
  ],
  "blocks": [
    {
      "type": "social_link",
      "name": "Social Media Icon",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Select Platform",
          "options": [
