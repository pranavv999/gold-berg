{% comment %}
  Custom Floating Footer Section for SOBER ANIMAL with Newsletter, Social Icons, 2 Nav Columns & Watermark
{% endcomment %}

{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="custom-footer-section">
  <div class="custom-footer-outer-wrapper">
    {% comment %} Floating Inner White Footer Card Container {% endcomment %}
    <div class="custom-footer-card">
      <div class="custom-footer-content-grid">
        {% comment %} Left Column: Newsletter & Social Links {% endcomment %}
        <div class="custom-footer-left">
          <div class="custom-footer-newsletter">
            {%- if section.settings.newsletter_heading != blank -%}
              <h2 class="footer-newsletter-heading">
                {{ section.settings.newsletter_heading | escape }}
              </h2>
            {%- else -%}
              <h2 class="footer-newsletter-heading">SUBSCRIBE TO OUR NEWSLETTER</h2>
            {%- endif -%}

            {%- if section.settings.newsletter_subtext != blank -%}
              <p class="footer-newsletter-subtext">{{ section.settings.newsletter_subtext | escape }}</p>
            {%- endif -%}

            {%- form 'customer', id: 'FooterNewsletterForm', class: 'footer-newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="newsletter-form__field-wrapper">
                <div class="field">
                  <input
                    id="NewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="field__input newsletter-field__input"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="FooterNewsletter-error"
                    {% elsif form.posted_successfully? %}
                      aria-describedby="FooterNewsletter-success"
                    {% endif %}
                    placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email address' }}"
                    required
                  >
                  <label class="field__label visually-hidden" for="NewsletterForm--{{ section.id }}">
                    {{ 'newsletter.label' | t | default: 'Email' }}
                  </label>
                  <button
                    type="submit"
                    class="newsletter-form__button"
                    name="commit"
                    id="Subscribe"
                    aria-label="{{ 'newsletter.button_label' | t | default: 'Subscribe' }}"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </button>
                </div>
                {%- if form.errors -%}
                  <small class="newsletter-form__message form__message" id="FooterNewsletter-error">
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </small>
                {%- endif -%}
              </div>
              {%- if form.posted_successfully? -%}
                <h3
                  class="newsletter-form__message newsletter-form__message--success form__message"
                  id="FooterNewsletter-success"
                  tabindex="-1"
                  autofocus
                >
                  {{- 'newsletter.success' | t | default: 'Thanks for subscribing!' -}}
                </h3>
              {%- endif -%}
            {%- endform -%}
          </div>

          {% comment %} Social Icons Below Newsletter {% endcomment %}
          <div class="custom-footer-social">
            {%- liquid
              assign social_blocks = section.blocks | where: 'type', 'social_link'
            -%}
            {%- if social_blocks.size > 0 -%}
              <div class="footer-social-list">
                {%- for block in social_blocks -%}
                  <a
                    href="{{ block.settings.url | default: '#' }}"
                    class="footer-social-icon-link"
                    target="_blank"
                    rel="noopener"
                    title="{{ block.settings.title | escape }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 60 | image_tag: class: 'footer-social-logo-img', alt: block.settings.title }}
                    {%- else -%}
                      <span class="footer-social-fallback-icon">{{ block.settings.title | slice: 0, 1 | upcase }}</span>
                    {%- endif -%}
                  </a>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="footer-social-list">
                <a href="{{ settings.social_instagram_link | default: 'https://instagram.com' }}" class="footer-social-icon-link" target="_blank" rel="noopener" aria-label="Instagram">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                </a>
                <a href="{{ settings.social_twitter_link | default: 'https://x.com' }}" class="footer-social-icon-link" target="_blank" rel="noopener" aria-label="X (Twitter)">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
                <a href="{{ settings.social_youtube_link | default: 'https://youtube.com' }}" class="footer-social-icon-link" target="_blank" rel="noopener" aria-label="YouTube">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
                </a>
                <a href="{{ settings.social_tiktok_link | default: 'https://tiktok.com' }}" class="footer-social-icon-link" target="_blank" rel="noopener" aria-label="TikTok">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>

        {% comment %} Right Column: 2 Navigation Columns {% endcomment %}
        <div class="custom-footer-right">
          {% comment %} Column A: Customer Support {% endcomment %}
          <div class="custom-footer-nav-col">
            <h3 class="footer-nav-heading">
              {{ section.settings.col1_heading | default: 'Customer Support' }}
            </h3>
            <ul class="footer-nav-list">
              {%- if section.settings.col1_menu != blank and section.settings.col1_menu.links.size > 0 -%}
                {%- for link in section.settings.col1_menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="footer-nav-link">{{ link.title | escape }}</a>
                  </li>
                {%- endfor -%}
              {%- else -%}
                <li><a href="/pages/track-order" class="footer-nav-link">Track Order</a></li>
                <li><a href="/pages/contact" class="footer-nav-link">Contact Us</a></li>
                <li><a href="/policies/refund-policy" class="footer-nav-link">Return / Exchange</a></li>
                <li><a href="/pages/get-hired" class="footer-nav-link">Get Hired</a></li>
              {%- endif -%}
            </ul>
          </div>

          {% comment %} Column B: Information & Policies {% endcomment %}
          <div class="custom-footer-nav-col">
            <h3 class="footer-nav-heading">
              {{ section.settings.col2_heading | default: 'Information & Policies' }}
            </h3>
            <ul class="footer-nav-list">
              {%- if section.settings.col2_menu != blank and section.settings.col2_menu.links.size > 0 -%}
                {%- for link in section.settings.col2_menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="footer-nav-link">{{ link.title | escape }}</a>
                  </li>
                {%- endfor -%}
              {%- else -%}
                <li><a href="/pages/about" class="footer-nav-link">About Us</a></li>
                <li><a href="/policies/terms-of-service" class="footer-nav-link">Terms</a></li>
                <li><a href="/policies/privacy-policy" class="footer-nav-link">Privacy Policy</a></li>
                <li><a href="/policies/shipping-policy" class="footer-nav-link">Shipping Policy</a></li>
                <li><a href="/policies/refund-policy" class="footer-nav-link">Refund Policy</a></li>
              {%- endif -%}
            </ul>
          </div>
        </div>
      </div>

      {% comment %} Separator Line & Copyright Bar {% endcomment %}
      <div class="custom-footer-bottom-bar">
        <div class="footer-copyright-text">
          {{ section.settings.copyright_text | default: '© 2026 SOBER ANIMAL. All rights reserved.' }}
        </div>
      </div>
    </div>

    {% comment %} Giant Half-Cut Watermark Text at Bottom ("Sober") {% endcomment %}
    <div class="custom-footer-watermark-wrapper" aria-hidden="true">
      <span class="custom-footer-watermark-text">
        {{ section.settings.watermark_text | default: 'Sober' }}
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "section-footer",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter Section"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "SUBSCRIBE TO OUR NEWSLETTER"
    },
    {
      "type": "text",
      "id": "newsletter_subtext",
      "label": "Newsletter Subtext"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Newsletter Field Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "header",
      "content": "Navigation Columns"
    },
    {
      "type": "text",
      "id": "col1_heading",
      "label": "Column A Heading",
      "default": "Customer Support"
    },
    {
      "type": "link_list",
      "id": "col1_menu",
      "label": "Column A Menu"
    },
    {
      "type": "text",
      "id": "col2_heading",
      "label": "Column B Heading",
      "default": "Information & Policies"
    },
    {
      "type": "link_list",
      "id": "col2_menu",
      "label": "Column B Menu"
    },
    {
      "type": "header",
      "content": "Bottom Copyright Bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "© 2026 SOBER ANIMAL. All rights reserved."
    },
    {
      "type": "header",
      "content": "Giant Watermark Text"
    },
    {
      "type": "text",
      "id": "watermark_text",
      "label": "Watermark Text",
      "default": "Sober"
    }
  ],
  "blocks": [
    {
      "type": "social_link",
      "name": "Social Logo Link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Platform Title / Alt Text",
          "default": "Instagram"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Social Logo Image (Fixed size)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Social Profile URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
