{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if page.handle == 'about' or request.path contains '/pages/about' -%}
  {{ 'section-about-page.css' | asset_url | stylesheet_tag }}

  <div class="about-page-wrapper section-{{ section.id }}-padding">
    <div class="about-page-container">
      {% comment %} Left Half: Configurable Image {% endcomment %}
      <div class="about-page-left">
        <div class="about-image-card">
          {%- if settings.about_image != blank -%}
            {{
              settings.about_image
              | image_url: width: 1400
              | image_tag:
                loading: 'eager',
                class: 'about-image',
                alt: 'About Us'
            }}
          {%- else -%}
            <img
              src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1200&q=80"
              alt="About Us"
              class="about-image"
            >
          {%- endif -%}
        </div>
      </div>

      {% comment %} Right Half: About Us Text Content {% endcomment %}
      <div class="about-page-right">
        <div class="about-content-inner">
          <h1 class="about-page-title">
            {{ page.title | default: 'ABOUT US' }}
          </h1>

          <div class="about-page-body rte">
            {%- if page.content != blank -%}
              {{ page.content }}
            {%- else -%}
              <p>
                SOBER ANIMAL (pronounced: So-ber An-i-mal) is a premium streetwear brand founded on bold expression and unapologetic individuality. Inspired by urban culture, raw creative energy, and modern lifestyle, our designs blend striking graphics with everyday comfort.
              </p>
              <p>
                We don’t follow trends — we create pieces that let you stand out, speak up, and express who you truly are. Each collection tells a story of craftsmanship, authenticity, and visual identity.
              </p>
              <h3>About the Founders</h3>
              <p>
                Driven by a shared passion for fashion and design, the founders established SOBER ANIMAL to bridge the gap between high-street fashion and everyday street style. Over time, the label has evolved into a community focused on quality, detail, and growing together.
              </p>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- else -%}
  <div class="page-width page-width--narrow section-{{ section.id }}-padding main-page-content-wrapper">
    <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ page.title | escape }}
    </h1>
    <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ page.content }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
