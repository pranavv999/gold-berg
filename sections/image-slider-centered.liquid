{%- style -%}
  .image-slider-outer {
    background: #f7f7f8;
    padding: 24px !important;
    display: flex;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
  }

  .image-slider-container {
    background: #ffffff;
    border-radius: var(--container-radius, 32px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04);
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto;
    padding: 3.5rem 4rem;
    box-sizing: border-box;
  }

  .image-slider-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .image-slider-heading {
    font-family: var(--font-body-family), -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    color: #1d1d1f !important;
    margin: 0;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
  }

  .image-slider-carousel-wrapper {
    position: relative;
    overflow: hidden;
    width: 100%;
    touch-action: pan-y;
  }

  .image-slider-track {
    display: flex;
    gap: 2rem;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
  }

  .image-slider-card-item {
    flex: 0 0 calc((100% - (2rem * 4)) / 5);
    min-width: 160px;
    box-sizing: border-box;
  }

  @media screen and (max-width: 1024px) {
    .image-slider-card-item {
      flex: 0 0 calc((100% - (2rem * 3)) / 4);
    }
  }

  @media screen and (max-width: 749px) {
    .image-slider-outer {
      padding: 16px !important;
    }
    .image-slider-container {
      padding: 1.5rem !important;
      border-radius: 24px !important;
    }
    .image-slider-header {
      margin-bottom: 2rem !important;
    }
    .image-slider-card-item {
      flex: 0 0 calc((100% - 1.5rem) / 2);
    }
    .image-slider-track {
      gap: 1.5rem;
    }
  }

  @media screen and (max-width: 480px) {
    .image-slider-card-item {
      flex: 0 0 calc((100% - 1.2rem) / 2);
    }
    .image-slider-track {
      gap: 1.2rem;
    }
  }

  .image-slider-card {
    display: block;
    position: relative;
    background: #f2f2f4;
    border-radius: 18px;
    aspect-ratio: 0.85;
    overflow: hidden;
    width: 100%;
    text-decoration: none;
  }

  .image-slider-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .image-slider-card.fit-contain img {
    object-fit: contain !important;
    padding: 12px;
  }

  .image-slider-card.fit-cover img {
    object-fit: cover !important;
    padding: 0;
  }

  .image-slider-card:hover img {
    transform: scale(1.05);
  }

  .image-slider-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e5e5ea;
    color: #8e8e93;
  }

  /* ARROWS & DOTS */
  .image-slider-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 2rem;
  }

  .image-slider-arrow {
    background: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #1d1d1f;
    transition: background 0.2s, border-color 0.2s;
  }

  .image-slider-arrow:hover {
    background: #f7f7f8;
    border-color: #d1d1d6;
  }

  .image-slider-dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .image-slider-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d1d1d6;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.25s, transform 0.25s;
  }

  .image-slider-dot.active {
    background: #1d1d1f;
    transform: scale(1.25);
  }
{%- endstyle -%}

<div class="image-slider-outer" id="ImageSlider-{{ section.id }}">
  <div class="image-slider-container">
    {%- if section.settings.heading != blank -%}
      <div class="image-slider-header">
        <h2 class="image-slider-heading">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div
      class="image-slider-carousel-wrapper"
      role="region"
      aria-label="{{ section.settings.aria_label | escape }}"
      data-autoplay="{{ section.settings.autoplay }}"
      data-interval="{{ section.settings.autoplay_interval }}"
    >
      <div class="image-slider-track" id="SliderTrack-{{ section.id }}">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="image-slider-card-item" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="image-slider-card fit-{{ section.settings.image_fit }}">
              {%- else -%}
                <div class="image-slider-card fit-{{ section.settings.image_fit }}">
              {%- endif -%}

                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    alt="{{ block.settings.alt | default: block.settings.image.alt | default: section.settings.heading | escape }}"
                    loading="lazy"
                    width="300"
                    height="350"
                  >
                {%- else -%}
                  <div class="image-slider-placeholder">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}

              {%- if block.settings.link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            <div class="image-slider-card-item">
              <div class="image-slider-card fit-contain">
                <div class="image-slider-placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if section.settings.show_arrows or section.settings.show_dots -%}
        <div class="image-slider-controls">
          {%- if section.settings.show_arrows -%}
            <button type="button" class="image-slider-arrow prev-btn" id="PrevBtn-{{ section.id }}" aria-label="Previous slide">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
          {%- endif -%}

          {%- if section.settings.show_dots -%}
            <div class="image-slider-dots" id="DotsNav-{{ section.id }}"></div>
          {%- endif -%}

          {%- if section.settings.show_arrows -%}
            <button type="button" class="image-slider-arrow next-btn" id="NextBtn-{{ section.id }}" aria-label="Next slide">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    const sectionId = {{ section.id | json }};
    const track = document.getElementById('SliderTrack-' + sectionId);
    if (!track) return;

    const wrapper = track.parentElement;
    const isAutoplay = wrapper.getAttribute('data-autoplay') === 'true';
    const intervalTime = parseInt(wrapper.getAttribute('data-interval') || '5000', 10);
    const prevBtn = document.getElementById('PrevBtn-' + sectionId);
    const nextBtn = document.getElementById('NextBtn-' + sectionId);
    const dotsNav = document.getElementById('DotsNav-' + sectionId);

    let items = Array.from(track.children);
    if (items.length === 0) return;

    let currentIndex = 0;
    let autoplayTimer = null;

    function getItemsPerPage() {
      const w = window.innerWidth;
      if (w <= 749) return 2;
      if (w <= 1024) return 4;
      return 5;
    }

    function getMaxIndex() {
      const perPage = getItemsPerPage();
      return Math.max(0, items.length - perPage);
    }

    function updateSlider() {
      const maxIndex = getMaxIndex();
      if (currentIndex > maxIndex) currentIndex = 0;
      if (currentIndex < 0) currentIndex = maxIndex;

      const firstItem = items[0];
      if (!firstItem) return;

      const itemWidth = firstItem.offsetWidth;
      const gap = parseInt(window.getComputedStyle(track).gap || '20', 10);
      const moveDistance = (itemWidth + gap) * currentIndex;

      track.style.transform = `translateX(-${moveDistance}px)`;

      // Update dots if enabled
      if (dotsNav) {
        const dots = Array.from(dotsNav.children);
        dots.forEach((dot, idx) => {
          dot.classList.toggle('active', idx === currentIndex);
        });
      }
    }

    function renderDots() {
      if (!dotsNav) return;
      dotsNav.innerHTML = '';
      const maxIndex = getMaxIndex();
      for (let i = 0; i <= maxIndex; i++) {
        const dot = document.createElement('button');
        dot.className = 'image-slider-dot' + (i === currentIndex ? ' active' : '');
        dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        dot.addEventListener('click', () => {
          currentIndex = i;
          updateSlider();
          resetAutoplay();
        });
        dotsNav.appendChild(dot);
      }
    }

    function nextSlide() {
      const maxIndex = getMaxIndex();
      if (currentIndex >= maxIndex) {
        currentIndex = 0;
      } else {
        currentIndex++;
      }
      updateSlider();
    }

    function prevSlide() {
      const maxIndex = getMaxIndex();
      if (currentIndex <= 0) {
        currentIndex = maxIndex;
      } else {
        currentIndex--;
      }
      updateSlider();
    }

    function startAutoplay() {
      if (!isAutoplay) return;
      stopAutoplay();
      autoplayTimer = setInterval(nextSlide, intervalTime);
    }

    function stopAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
    }

    function resetAutoplay() {
      stopAutoplay();
      startAutoplay();
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        prevSlide();
        resetAutoplay();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        nextSlide();
        resetAutoplay();
      });
    }

    // Touch swipe support
    let startX = 0;
    let currentX = 0;
    let isSwiping = false;

    wrapper.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      isSwiping = true;
      stopAutoplay();
    }, { passive: true });

    wrapper.addEventListener('touchmove', (e) => {
      if (!isSwiping) return;
      currentX = e.touches[0].clientX;
    }, { passive: true });

    wrapper.addEventListener('touchend', () => {
      if (!isSwiping) return;
      const diffX = startX - currentX;
      if (Math.abs(diffX) > 40) {
        if (diffX > 0) {
          nextSlide();
        } else {
          prevSlide();
        }
      }
      isSwiping = false;
      startAutoplay();
    });

    // Theme Editor Live Block Selection
    if (Shopify && Shopify.designMode) {
      document.addEventListener('shopify:block:select', (evt) => {
        if (evt.detail.sectionId === sectionId) {
          const blockId = evt.detail.blockId;
          const idx = items.findIndex(item => item.getAttribute('data-block-id') === blockId);
          if (idx !== -1) {
            currentIndex = idx;
            updateSlider();
            stopAutoplay();
          }
        }
      });

      document.addEventListener('shopify:block:deselect', (evt) => {
        if (evt.detail.sectionId === sectionId) {
          startAutoplay();
        }
      });
    }

    renderDots();
    updateSlider();
    startAutoplay();

    window.addEventListener('resize', () => {
      renderDots();
      updateSlider();
    });
  })();
</script>

{% schema %}
{
  "name": "Image slider (centered)",
  "tag": "section",
  "class": "section-image-slider-centered",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "AS SEEN ON"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 1000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "label": "Autoplay interval (ms) — time it takes to move one card",
      "default": 5000
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "ARIA label for the carousel",
      "default": "Image slider carousel"
    },
    {
      "type": "checkbox",
      "id": "adapt_height",
      "label": "Adapt slide height to image",
      "default": true
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "contain",
          "label": "Contain (no crop)"
        },
        {
          "value": "cover",
          "label": "Cover (fill)"
        }
      ],
      "default": "cover"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide link"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image slider (block style centered)",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
