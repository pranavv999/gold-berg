{%- style -%}
  .image-slider-outer {
    background: #f7f7f8;
    padding: 24px !important;
    display: flex;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
  }

  .image-slider-container {
    background: #ffffff;
    border-radius: var(--container-radius, 32px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04);
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto;
    padding: 3.5rem 4rem;
    box-sizing: border-box;
  }

  .image-slider-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .image-slider-heading {
    font-family: var(--font-body-family), -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    color: #1d1d1f !important;
    margin: 0;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
  }

  .image-slider-carousel-wrapper {
    position: relative;
    overflow: hidden;
    width: 100%;
    touch-action: pan-y;
  }

  .image-slider-track {
    display: flex;
    gap: 2rem;
    width: max-content;
    will-change: transform;
  }

  .image-slider-card-item {
    width: 258px;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  @media screen and (max-width: 1024px) {
    .image-slider-card-item {
      width: 228px;
    }
  }

  @media screen and (max-width: 749px) {
    .image-slider-outer {
      padding: 16px 5px !important;
    }
    .image-slider-container {
      padding: 1.5rem !important;
      border-radius: var(--container-radius, 24px) !important;
    }
    .image-slider-header {
      margin-bottom: 2rem !important;
    }
    .image-slider-card-item {
      width: 193px;
    }
    .image-slider-track {
      gap: 1.2rem;
    }
  }

  .image-slider-card {
    display: block;
    position: relative;
    background: #f2f2f4;
    border-radius: 10px;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    width: 100%;
    text-decoration: none;
  }

  .image-slider-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .image-slider-card.fit-contain img {
    object-fit: contain !important;
    padding: 12px;
  }

  .image-slider-card.fit-cover img {
    object-fit: cover !important;
    padding: 0;
  }

  .image-slider-card:hover img {
    transform: scale(1.05);
  }

  .image-slider-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e5e5ea;
    color: #8e8e93;
  }

  /* ARROWS & DOTS */
  .image-slider-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 2rem;
  }

  .image-slider-arrow {
    background: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #1d1d1f;
    transition: background 0.2s, border-color 0.2s;
  }

  .image-slider-arrow:hover {
    background: #f7f7f8;
    border-color: #d1d1d6;
  }
{%- endstyle -%}

<div class="image-slider-outer" id="ImageSlider-{{ section.id }}">
  <div class="image-slider-container" style="--container-radius: {{ section.settings.container_radius }}px;">
    {%- if section.settings.heading != blank -%}
      <div class="image-slider-header">
        <h2 class="image-slider-heading">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div
      class="image-slider-carousel-wrapper"
      role="region"
      aria-label="{{ section.settings.aria_label | escape }}"
      data-autoplay="{{ section.settings.autoplay }}"
      data-interval="{{ section.settings.autoplay_interval }}"
    >
      <div class="image-slider-track" id="SliderTrack-{{ section.id }}">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="image-slider-card-item" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="image-slider-card fit-{{ section.settings.image_fit }}">
              {%- else -%}
                <div class="image-slider-card fit-{{ section.settings.image_fit }}">
              {%- endif -%}

                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    alt="{{ block.settings.alt | default: block.settings.image.alt | default: section.settings.heading | escape }}"
                    loading="lazy"
                    width="300"
                    height="350"
                  >
                {%- else -%}
                  <div class="image-slider-placeholder">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}

              {%- if block.settings.link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for j in (1..6) -%}
            <div class="image-slider-card-item">
              <div class="image-slider-card fit-contain">
                <div class="image-slider-placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if section.settings.show_arrows -%}
        <div class="image-slider-controls">
          <button type="button" class="image-slider-arrow prev-btn" id="PrevBtn-{{ section.id }}" aria-label="Previous slide">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <button type="button" class="image-slider-arrow next-btn" id="NextBtn-{{ section.id }}" aria-label="Next slide">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    const sectionId = {{ section.id | json }};
    const track = document.getElementById('SliderTrack-' + sectionId);
    if (!track) return;

    const wrapper = track.parentElement;
    const isAutoplay = wrapper.getAttribute('data-autoplay') === 'true';
    const intervalMs = parseInt(wrapper.getAttribute('data-interval') || '5000', 10);
    const speed = Math.max(0.5, 3800 / intervalMs);

    const originalItems = Array.from(track.children).filter(el => !el.classList.contains('is-clone'));
    if (originalItems.length === 0) return;

    function getOriginalWidth() {
      let totalWidth = 0;
      const gap = parseFloat(window.getComputedStyle(track).gap || '20');
      originalItems.forEach(el => {
        totalWidth += el.offsetWidth + gap;
      });
      return totalWidth;
    }

    let originalWidth = 0;

    function initClones() {
      // Clear old clones if any
      Array.from(track.children).forEach(child => {
        if (child.classList.contains('is-clone')) child.remove();
      });

      originalWidth = getOriginalWidth();
      if (originalWidth <= 0) return;

      // Ensure track length is at least (originalWidth + wrapper.clientWidth + 500)
      const requiredWidth = originalWidth + wrapper.clientWidth + 500;
      let safetyCounter = 0;
      while (track.scrollWidth < requiredWidth && safetyCounter < 15) {
        originalItems.forEach(item => {
          const clone = item.cloneNode(true);
          clone.removeAttribute('data-block-id');
          clone.removeAttribute('id');
          clone.classList.add('is-clone');
          track.appendChild(clone);
        });
        safetyCounter++;
      }
    }

    initClones();

    // Re-verify after load
    window.addEventListener('load', () => {
      initClones();
    });

    let animationFrame = null;
    let currentX = 0;
    let isPaused = false;

    function animate() {
      if (isAutoplay && !isPaused && originalWidth > 0) {
        currentX -= speed;
        if (Math.abs(currentX) >= originalWidth) {
          currentX += originalWidth;
        }
        track.style.transform = `translate3d(${currentX}px, 0, 0)`;
      }
      animationFrame = requestAnimationFrame(animate);
    }

    // Pause on hover
    wrapper.addEventListener('mouseenter', () => { isPaused = true; });
    wrapper.addEventListener('mouseleave', () => { isPaused = false; });

    // Touch swipe support
    let touchStartX = 0;
    let touchCurrentX = 0;
    let isTouching = false;

    wrapper.addEventListener('touchstart', (e) => {
      isTouching = true;
      isPaused = true;
      touchStartX = e.touches[0].clientX;
    }, { passive: true });

    wrapper.addEventListener('touchmove', (e) => {
      if (!isTouching || originalWidth <= 0) return;
      touchCurrentX = e.touches[0].clientX;
      const diff = touchCurrentX - touchStartX;
      touchStartX = touchCurrentX;
      currentX += diff;

      if (currentX > 0) currentX -= originalWidth;
      if (Math.abs(currentX) >= originalWidth) currentX += originalWidth;

      track.style.transform = `translate3d(${currentX}px, 0, 0)`;
    }, { passive: true });

    wrapper.addEventListener('touchend', () => {
      isTouching = false;
      isPaused = false;
    });

    const prevBtn = document.getElementById('PrevBtn-' + sectionId);
    const nextBtn = document.getElementById('NextBtn-' + sectionId);

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        const item = originalItems[0];
        if (item && originalWidth > 0) {
          const shift = item.offsetWidth + 20;
          currentX += shift;
          if (currentX > 0) currentX -= originalWidth;
          track.style.transform = `translate3d(${currentX}px, 0, 0)`;
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const item = originalItems[0];
        if (item && originalWidth > 0) {
          const shift = item.offsetWidth + 20;
          currentX -= shift;
          if (Math.abs(currentX) >= originalWidth) currentX += originalWidth;
          track.style.transform = `translate3d(${currentX}px, 0, 0)`;
        }
      });
    }

    window.addEventListener('resize', () => {
      initClones();
    });

    // Theme Editor Live Block Selection
    if (Shopify && Shopify.designMode) {
      document.addEventListener('shopify:block:select', (evt) => {
        if (evt.detail.sectionId === sectionId) {
          isPaused = true;
        }
      });

      document.addEventListener('shopify:block:deselect', (evt) => {
        if (evt.detail.sectionId === sectionId) {
          isPaused = false;
        }
      });
    }

    animate();
  })();
</script>

{% schema %}
{
  "name": "Image slider (centered)",
  "tag": "section",
  "class": "section-image-slider-centered",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "AS SEEN ON"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 1000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "label": "Autoplay interval (ms) — time it takes to move one card",
      "default": 5000
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "ARIA label for the carousel",
      "default": "Image slider carousel"
    },
    {
      "type": "checkbox",
      "id": "adapt_height",
      "label": "Adapt slide height to image",
      "default": true
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "contain",
          "label": "Contain (no crop)"
        },
        {
          "value": "cover",
          "label": "Cover (fill)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "container_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24,
      "label": "Container corner radius"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide link"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image slider (block style centered)",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
