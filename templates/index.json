{
  "sections": {
    "image_banner": {
      "type": "image-banner",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Browse our latest products",
            "heading_size": "h2"
          }
        },
        "button": {
          "type": "buttons",
          "settings": {
            "button_label_1": "Shop all",
            "button_link_1": "shopify://collections/all",
            "button_style_secondary_1": true,
            "button_label_2": "",
            "button_link_2": "",
            "button_style_secondary_2": false
          }
        }
      },
      "block_order": [
        "heading",
        "button"
      ],
      "settings": {
        "image_overlay_opacity": 40,
        "image_height": "extra-large",
        "desktop_content_position": "bottom-center",
        "show_text_box": false,
        "image_behavior": "none",
        "desktop_content_alignment": "center",
        "color_scheme": "scheme-3",
        "mobile_content_alignment": "center",
        "stack_images_on_mobile": false,
        "show_text_below": false
      }
    },
    "custom_collection_row": {
      "type": "custom-collection-row",
      "settings": {
        "title": "",
        "collection": "all",
        "container_radius": 24
      }
    },
    "image_slider_centered": {
      "type": "image-slider-centered",
      "settings": {
        "heading": "AS SEEN ON",
        "autoplay": true,
        "autoplay_interval": 5000,
        "show_arrows": false,
        "show_dots": false,
        "aria_label": "Image slider carousel",
        "adapt_height": true,
        "image_fit": "cover"
      }
    },
    "fullwidth_image_slider": {
      "type": "image-slider-fullwidth",
      "settings": {
        "autoplay": true,
        "autoplay_interval": 5000,
        "show_arrows": true,
        "show_dots": true,
        "aria_label": "Full width image carousel",
        "image_fit": "cover"
      }
    },
    "instagram_reels_carousel": {
      "type": "instagram-reels-carousel",
      "settings": {
        "heading": "INSTAGRAM REELS",
        "autoplay": true,
        "autoplay_interval": 5000,
        "show_arrows": false,
        "container_radius": 24
      }
    },
    "featured_collection_grid_banners": {
      "type": "featured-collection-grid-banners",
      "settings": {
        "title": ""
      }
    }
  },
  "order": [
    "image_banner",
    "custom_collection_row",
    "image_slider_centered",
    "featured_collection_grid_banners",
    "fullwidth_image_slider",
    "instagram_reels_carousel"
  ]
}