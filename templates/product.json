{
  "sections": {
    "main": {
      "type": "custom-main-product",
      "blocks": {
        "accordion_details": {
          "type": "accordion_row",
          "settings": {
            "heading": "Details & Description",
            "show_description": true
          }
        },
        "accordion_washcare": {
          "type": "accordion_row",
          "settings": {
            "heading": "Washcare",
            "content": "<p>Washcare Instructions:</p><ul><li>Reverse wash only</li><li>Do not iron on the print</li><li>Steam iron recommended</li><li>Dry in shade</li></ul>"
          }
        },
        "accordion_shipping": {
          "type": "accordion_row",
          "settings": {
            "heading": "Shipping",
            "content": "<p>Shipping & Delivery Details:</p><ul><li>Standard delivery: 3-5 business days</li><li>Free shipping on orders over RS. 4,999</li><li>Easy 7-day hassle-free returns</li><li>Cash on delivery available</li></ul>"
          }
        },
        "trust_benefits_card": {
          "type": "trust_benefits_card",
          "settings": {
            "heading": "CRAFTED FOR COMFORT. BUILT TO LAST.",
            "show_lines": true,
            "card_bg_color": "#000000",
            "card_text_color": "#ffffff",
            "card_padding_vertical": 24,
            "card_padding_horizontal": 20,
            "item_1_icon": "support",
            "item_1_title": "24/7 Support",
            "item_2_icon": "secure_payment",
            "item_2_title": "Secure Payments",
            "item_3_icon": "free_shipping",
            "item_3_title": "Free Shipping",
            "item_4_icon": "premium_quality",
            "item_4_title": "Premium Quality"
          }
        }
      },
      "block_order": [
        "accordion_details",
        "accordion_washcare",
        "accordion_shipping",
        "trust_benefits_card"
      ],
      "settings": {
        "container_radius": 24
      }
    },
    "people-also-buy": {
      "type": "custom-collection-row",
      "settings": {
        "title": "PEOPLE ALSO BUY",
        "product_source": "related_products",
        "hide_discover_more": true,
        "container_radius": 24
      }
    }
  },
  "order": [
    "main",
    "people-also-buy"
  ]
}