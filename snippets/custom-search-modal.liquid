{% comment %}
  Renders the custom production-style search modal popup with Recently Viewed, Featured Products, Predictive Search, and View All CTA.
{% endcomment %}

<div class="custom-search-modal-overlay" id="custom-search-modal" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="custom-search-modal-card">
    <!-- Top Input Header Bar -->
    <div class="search-modal-input-row">
      <span class="search-modal-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </span>

      <input
        type="search"
        id="custom-search-modal-input"
        class="custom-search-modal-input"
        placeholder="Search"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
      >

      <button type="button" class="custom-search-clear-btn" id="custom-search-clear-btn" style="display:none;">
        Clear
      </button>

      <button type="button" class="custom-search-close-btn" onclick="closeCustomSearchModal()" aria-label="Close search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Modal Content Body -->
    <div class="custom-search-modal-body">
      <!-- INITIAL STATE (EMPTY QUERY) -->
      <div id="search-modal-initial-state" class="search-modal-state">
        <!-- Recently Viewed Section -->
        <div class="search-modal-section" id="recently-viewed-section" style="display:none;">
          <div class="search-modal-section-header">
            <span class="search-modal-section-title">Recently viewed</span>
            <button type="button" class="search-modal-clear-recent" id="clear-recently-viewed-btn">CLEAR</button>
          </div>
          <div class="search-modal-products-grid" id="recently-viewed-products-grid"></div>
        </div>

        <!-- Default Featured Products Section -->
        <div class="search-modal-section">
          <div class="search-modal-section-header">
            <span class="search-modal-section-title">Products</span>
          </div>
          <div class="search-modal-products-grid">
            {%- assign featured_collection = collections['all'] | default: collections.first -%}
            {%- for product in featured_collection.products limit: 4 -%}
              <a href="{{ product.url }}" class="search-modal-product-card">
                <div class="search-modal-product-image-wrapper">
                  {%- if product.featured_media != blank -%}
                    <img src="{{ product.featured_media | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy">
                  {%- endif -%}
                </div>
                <div class="search-modal-product-info">
                  <h3 class="search-modal-product-title">{{ product.title | escape }}</h3>
                  <div class="search-modal-product-price">
                    {%- if product.compare_at_price > product.price -%}
                      <s class="compare-price">{{ product.compare_at_price | money }}</s>
                    {%- endif -%}
                    <span class="current-price">{{ product.price | money }}</span>
                  </div>
                </div>
              </a>
            {%- endfor -%}
          </div>
        </div>
      </div>

      <!-- TYPING / ACTIVE PREDICTIVE SEARCH STATE -->
      <div id="search-modal-active-state" class="search-modal-state" style="display:none;">
        <!-- Query Suggestions Pills -->
        <div class="search-modal-suggestions-row" id="search-modal-suggestions-row"></div>

        <!-- Matching Products Section -->
        <div class="search-modal-section">
          <div class="search-modal-section-header">
            <span class="search-modal-section-title">Products</span>
          </div>
          <div class="search-modal-products-grid" id="search-modal-results-grid"></div>
        </div>

        <!-- Bottom View All CTA -->
        <div class="search-modal-footer">
          <button type="button" class="search-modal-view-all-btn" id="search-modal-view-all-btn">
            VIEW ALL
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .custom-search-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 999999;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 40px 16px;
    box-sizing: border-box;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .custom-search-modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .custom-search-modal-card {
    background: #ffffff;
    border-radius: 20px;
    width: 100%;
    max-width: 680px;
    max-height: calc(100vh - 80px);
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
    transform: translateY(16px) scale(0.98);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .custom-search-modal-overlay.active .custom-search-modal-card {
    transform: translateY(0) scale(1);
  }

  .search-modal-input-row {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid #f2f2f4;
    gap: 12px;
  }

  .search-modal-icon {
    display: flex;
    align-items: center;
    color: #1d1d1f;
  }

  .custom-search-modal-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-body-family), -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-size: 15px !important;
    color: #1d1d1f !important;
  }

  .custom-search-modal-input::placeholder {
    color: #8e8e93 !important;
  }

  .custom-search-clear-btn {
    background: none;
    border: none;
    font-family: var(--font-body-family), sans-serif;
    font-size: 12px;
    color: #8e8e93;
    cursor: pointer;
    padding: 4px 8px;
  }

  .custom-search-clear-btn:hover {
    color: #1d1d1f;
  }

  .custom-search-close-btn {
    background: none;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #1d1d1f;
    padding: 4px;
  }

  .custom-search-modal-body {
    padding: 24px;
    overflow-y: auto;
    flex: 1;
  }

  .search-modal-section {
    margin-bottom: 24px;
  }

  .search-modal-section:last-child {
    margin-bottom: 0;
  }

  .search-modal-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .search-modal-section-title {
    font-family: var(--font-body-family), sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: #6e6e73;
  }

  .search-modal-clear-recent {
    background: none;
    border: none;
    font-family: var(--font-body-family), sans-serif;
    font-size: 11px;
    font-weight: 600;
    color: #8e8e93;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .search-modal-clear-recent:hover {
    color: #1d1d1f;
  }

  .search-modal-products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  @media screen and (max-width: 600px) {
    .search-modal-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }

  .search-modal-product-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .search-modal-product-image-wrapper {
    aspect-ratio: 0.85;
    border-radius: 12px;
    overflow: hidden;
    background: #f7f7f8;
    margin-bottom: 8px;
  }

  .search-modal-product-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .search-modal-product-card:hover .search-modal-product-image-wrapper img {
    transform: scale(1.04);
  }

  .search-modal-product-title {
    font-family: var(--font-body-family), sans-serif;
    font-size: 11px;
    font-weight: 400;
    color: #1d1d1f;
    margin: 0 0 4px 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-modal-product-price {
    font-family: var(--font-body-family), sans-serif;
    font-size: 10.5px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .search-modal-product-price .compare-price {
    color: #8e8e93;
    text-decoration: line-through;
  }

  .search-modal-product-price .current-price {
    color: #1d1d1f;
    font-weight: 500;
  }

  .search-modal-suggestions-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .search-modal-suggestion-pill {
    background: #f2f2f4;
    border-radius: 20px;
    padding: 6px 14px;
    font-family: var(--font-body-family), sans-serif;
    font-size: 11px;
    color: #1d1d1f;
    cursor: pointer;
    border: none;
    transition: background 0.2s;
  }

  .search-modal-suggestion-pill:hover {
    background: #e5e5ea;
  }

  .search-modal-footer {
    display: flex;
    justify-content: center;
    margin-top: 24px;
  }

  .search-modal-view-all-btn {
    background: #000000;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 12px 28px;
    font-family: var(--font-body-family), sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .search-modal-view-all-btn:hover {
    opacity: 0.85;
  }
</style>

<script>
  (function () {
    const RECENT_KEY = 'sober_recently_viewed';

    // Track recently viewed products when on product page
    {% if template contains 'product' %}
      try {
        const currentProd = {
          id: {{ product.id | json }},
          title: {{ product.title | json }},
          url: {{ product.url | json }},
          image: {{ product.featured_media | image_url: width: 300 | json }},
          price: {{ product.price | money | json }},
          compare_price: {% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %}
        };
        let recentList = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
        recentList = recentList.filter(item => item.id !== currentProd.id);
        recentList.unshift(currentProd);
        if (recentList.length > 4) recentList = recentList.slice(0, 4);
        localStorage.setItem(RECENT_KEY, JSON.stringify(recentList));
      } catch (e) {}
    {% endif %}

    window.openCustomSearchModal = function (evt) {
      if (evt) evt.preventDefault();
      const modal = document.getElementById('custom-search-modal');
      const input = document.getElementById('custom-search-modal-input');
      if (modal) {
        modal.classList.add('active');
        renderRecentlyViewed();
        if (input) {
          setTimeout(() => input.focus(), 150);
        }
      }
    };

    window.closeCustomSearchModal = function () {
      const modal = document.getElementById('custom-search-modal');
      if (modal) {
        modal.classList.remove('active');
      }
    };

    function renderRecentlyViewed() {
      const section = document.getElementById('recently-viewed-section');
      const grid = document.getElementById('recently-viewed-products-grid');
      if (!section || !grid) return;

      try {
        const recentList = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
        if (recentList.length > 0) {
          grid.innerHTML = recentList.map(item => `
            <a href="${item.url}" class="search-modal-product-card">
              <div class="search-modal-product-image-wrapper">
                <img src="${item.image}" alt="${item.title}">
              </div>
              <div class="search-modal-product-info">
                <h3 class="search-modal-product-title">${item.title}</h3>
                <div class="search-modal-product-price">
                  ${item.compare_price ? `<s class="compare-price">${item.compare_price}</s>` : ''}
                  <span class="current-price">${item.price}</span>
                </div>
              </div>
            </a>
          `).join('');
          section.style.display = 'block';
        } else {
          section.style.display = 'none';
        }
      } catch (e) {
        section.style.display = 'none';
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('custom-search-modal-input');
      const clearBtn = document.getElementById('custom-search-clear-btn');
      const initialState = document.getElementById('search-modal-initial-state');
      const activeState = document.getElementById('search-modal-active-state');
      const suggestionsRow = document.getElementById('search-modal-suggestions-row');
      const resultsGrid = document.getElementById('search-modal-results-grid');
      const viewAllBtn = document.getElementById('search-modal-view-all-btn');
      const clearRecentBtn = document.getElementById('clear-recently-viewed-btn');

      if (clearRecentBtn) {
        clearRecentBtn.addEventListener('click', () => {
          localStorage.removeItem(RECENT_KEY);
          renderRecentlyViewed();
        });
      }

      if (input) {
        input.addEventListener('input', function () {
          const query = input.value.trim();
          if (query.length > 0) {
            if (clearBtn) clearBtn.style.display = 'block';
            if (initialState) initialState.style.display = 'none';
            if (activeState) activeState.style.display = 'block';
            fetchPredictiveResults(query);
          } else {
            if (clearBtn) clearBtn.style.display = 'none';
            if (initialState) initialState.style.display = 'block';
            if (activeState) activeState.style.display = 'none';
          }
        });

        input.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            const query = input.value.trim();
            if (query) {
              window.location.href = `/search?q=${encodeURIComponent(query)}`;
            }
          }
        });
      }

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          if (input) {
            input.value = '';
            input.focus();
          }
          clearBtn.style.display = 'none';
          if (initialState) initialState.style.display = 'block';
          if (activeState) activeState.style.display = 'none';
        });
      }

      let debounceTimer = null;
      function fetchPredictiveResults(query) {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product,query&resources[limit]=8`)
            .then(res => res.json())
            .then(data => {
              const suggestions = data.resources?.results?.queries || [];
              const products = data.resources?.results?.products || [];

              // Render Suggestion Pills
              if (suggestionsRow) {
                if (suggestions.length > 0) {
                  suggestionsRow.innerHTML = suggestions.map(s => `
                    <button type="button" class="search-modal-suggestion-pill" data-query="${s.text}">
                      ${s.text}
                    </button>
                  `).join('');
                  suggestionsRow.style.display = 'flex';

                  suggestionsRow.querySelectorAll('.search-modal-suggestion-pill').forEach(pill => {
                    pill.addEventListener('click', () => {
                      const text = pill.getAttribute('data-query');
                      if (input) input.value = text;
                      fetchPredictiveResults(text);
                    });
                  });
                } else {
                  suggestionsRow.style.display = 'none';
                }
              }

              // Render Product Cards
              if (resultsGrid) {
                if (products.length > 0) {
                  resultsGrid.innerHTML = products.map(p => {
                    let formattedPrice = p.price || (p.price_min ? `Rs. ${p.price_min}` : '');
                    if (typeof p.price === 'number') {
                      formattedPrice = `Rs. ${p.price.toLocaleString('en-IN')}`;
                    } else if (typeof p.price === 'string' && !p.price.includes('Rs') && !p.price.includes('₹')) {
                      formattedPrice = `Rs. ${p.price}`;
                    }

                    let formattedCompare = '';
                    if (p.compare_at_price_min && p.compare_at_price_min > (p.price_min || 0)) {
                      formattedCompare = typeof p.compare_at_price_min === 'number'
                        ? `Rs. ${p.compare_at_price_min.toLocaleString('en-IN')}`
                        : `Rs. ${p.compare_at_price_min}`;
                    } else if (p.compare_at_price) {
                      formattedCompare = typeof p.compare_at_price === 'string' && !p.compare_at_price.includes('Rs')
                        ? `Rs. ${p.compare_at_price}`
                        : p.compare_at_price;
                    }

                    return `
                      <a href="${p.url}" class="search-modal-product-card">
                        <div class="search-modal-product-image-wrapper">
                          ${p.image ? `<img src="${p.image}" alt="${p.title}">` : ''}
                        </div>
                        <div class="search-modal-product-info">
                          <h3 class="search-modal-product-title">${p.title}</h3>
                          <div class="search-modal-product-price">
                            ${formattedCompare ? `<s class="compare-price">${formattedCompare}</s>` : ''}
                            <span class="current-price">${formattedPrice}</span>
                          </div>
                        </div>
                      </a>
                    `;
                  }).join('');
                } else {
                  resultsGrid.innerHTML = `<p style="font-size:12px; color:#8e8e93; grid-column:span 4; text-align:center;">No products found</p>`;
                }
              }

              // Bind View All Button
              if (viewAllBtn) {
                viewAllBtn.onclick = function () {
                  window.location.href = `/search?q=${encodeURIComponent(query)}`;
                };
              }
            })
            .catch(() => {});
        }, 180);
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') window.closeCustomSearchModal();
      });

      document.addEventListener('click', (e) => {
        const modal = document.getElementById('custom-search-modal');
        if (modal && e.target === modal) {
          window.closeCustomSearchModal();
        }
      });
    });
  })();
</script>
