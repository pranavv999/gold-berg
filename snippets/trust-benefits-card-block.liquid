{% doc %}
  Renders a Trust & Benefits card block inside the product info column below the product details accordion section.

  @param {object} [block] - Optional block object containing settings
{% enddoc %}

{%- assign heading = block.settings.heading | default: 'CRAFTED FOR COMFORT. BUILT TO LAST.' -%}
{%- assign card_bg = block.settings.card_bg_color | default: '#000000' -%}
{%- assign card_color = block.settings.card_text_color | default: '#ffffff' -%}
{%- assign show_lines = block.settings.show_lines -%}
{%- if show_lines == null -%}
  {%- assign show_lines = true -%}
{%- endif -%}

{%- assign padding_v = block.settings.card_padding_vertical | default: 20 -%}
{%- assign padding_h = block.settings.card_padding_horizontal | default: 20 -%}

<div
  class="trust-benefits-column-card"
  style="
    --card-bg: {{ card_bg }};
    --card-color: {{ card_color }};
    --padding-v: {{ padding_v }}px;
    --padding-h: {{ padding_h }}px;
    --container-radius: {{ section.settings.container_radius | default: 24 }}px;
  "
  {% if block %}
    {{ block.shopify_attributes }}
  {% endif %}
>
  {%- if heading != blank -%}
    <div class="tb-card-header">
      {%- if show_lines -%}
        <span class="tb-card-line"></span>
      {%- endif -%}
      <h3 class="tb-card-title">{{ heading | escape }}</h3>
      {%- if show_lines -%}
        <span class="tb-card-line"></span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="tb-card-grid">
    {%- for i in (1..4) -%}
      {%- assign icon_key = 'item_' | append: i | append: '_icon' -%}
      {%- assign title_key = 'item_' | append: i | append: '_title' -%}
      {%- assign svg_key = 'item_' | append: i | append: '_custom_svg' -%}
      {%- assign img_key = 'item_' | append: i | append: '_custom_image' -%}

      {%- assign icon_val = block.settings[icon_key] -%}
      {%- assign title_val = block.settings[title_key] -%}
      {%- assign svg_val = block.settings[svg_key] -%}
      {%- assign img_val = block.settings[img_key] -%}

      {%- if block == null -%}
        {%- case i -%}
          {%- when 1 -%}
            {%- assign icon_val = 'support' -%}
            {%- assign title_val = '24/7 Support' -%}
          {%- when 2 -%}
            {%- assign icon_val = 'secure_payment' -%}
            {%- assign title_val = 'Secure Payments' -%}
          {%- when 3 -%}
            {%- assign icon_val = 'free_shipping' -%}
            {%- assign title_val = 'Free Shipping' -%}
          {%- when 4 -%}
            {%- assign icon_val = 'premium_quality' -%}
            {%- assign title_val = 'Premium Quality' -%}
        {%- endcase -%}
      {%- endif -%}

      {%- if title_val != blank or icon_val != blank or svg_val != blank or img_val != blank -%}
        <div class="tb-card-item">
          <div class="tb-card-icon-wrap">
            {%- if img_val != blank -%}
              {{ img_val | image_url: width: 60 | image_tag: class: 'tb-card-custom-img', loading: 'lazy' }}
            {%- elsif svg_val != blank -%}
              <div class="tb-card-custom-svg">
                {{ svg_val }}
              </div>
            {%- else -%}
              {%- case icon_val -%}
                {%- when 'support' -%}
                  <svg
                    viewBox="0 0 24 24"
                    class="tb-card-icon"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
                    <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/>
                    <path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
                  </svg>
                {%- when 'secure_payment' -%}
                  <svg
                    viewBox="0 0 24 24"
                    class="tb-card-icon"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <path d="m9 12 2 2 4-4"/>
                  </svg>
                {%- when 'free_shipping' -%}
                  <svg
                    viewBox="0 0 24 24"
                    class="tb-card-icon"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/>
                    <circle cx="18.5" cy="18.5" r="2.5"/>
                  </svg>
                {%- when 'premium_quality' -%}
                  <svg
                    viewBox="0 0 24 24"
                    class="tb-card-icon"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="8" r="6"/>
                    <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
                  </svg>
                {%- when 'returns' -%}
                  <svg
                    viewBox="0 0 24 24"
                    class="tb-card-icon"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M3 12a9 9 0 0 1 15-6.7L21 8"/>
                    <path d="M21 3v5h-5"/>
                    <path d="M21 12a9 9 0 0 1-15 6.7L3 16"/>
                    <path d="M3 21v-5h5"/>
                  </svg>
                {%- when 'clock' -%}
                  <svg
                    viewBox="0 0 24 24"
                    class="tb-card-icon"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                {%- else -%}
                  <svg
                    viewBox="0 0 24 24"
                    class="tb-card-icon"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="10"/>
                    <path d="m9 12 2 2 4-4"/>
                  </svg>
              {%- endcase -%}
            {%- endif -%}
          </div>
          {%- if title_val != blank -%}
            <span class="tb-card-item-title">{{ title_val | escape }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .trust-benefits-column-card {
    background-color: var(--card-bg, #000000);
    color: var(--card-color, #ffffff);
    border-radius: var(--container-radius, 24px);
    padding: var(--padding-v, 20px) var(--padding-h, 20px);
    margin-top: 0 !important;
    box-sizing: border-box;
    width: 100%;
  }

  .tb-card-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 20px;
    width: 100%;
  }

  .tb-card-title {
    margin: 0;
    font-family: var(--font-heading-family), -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: inherit;
    text-align: center;
    line-height: 1.3;
    white-space: normal;
  }

  .tb-card-line {
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.25);
  }

  .tb-card-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    row-gap: 16px;
    align-items: start;
    width: 100%;
  }

  .tb-card-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    position: relative;
  }

  .tb-card-item:not(:nth-child(4n))::after {
    content: '';
    position: absolute;
    right: -3px;
    top: 10%;
    height: 80%;
    width: 1px;
    background: rgba(255, 255, 255, 0.18);
  }

  .tb-card-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .tb-card-item:hover .tb-card-icon-wrap {
    transform: scale(1.08);
    border-color: rgba(255, 255, 255, 0.7);
  }

  .tb-card-icon {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    color: inherit;
  }

  .tb-card-custom-img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .tb-card-custom-svg {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tb-card-custom-svg svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .tb-card-item-title {
    font-family: var(--font-body-family), -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: inherit;
    line-height: 1.2;
  }

  @media screen and (max-width: 480px) {
    .trust-benefits-column-card {
      margin-top: 0 !important;
      padding: 16px 8px;
    }
    .tb-card-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2px;
      row-gap: 14px;
    }
    .tb-card-header {
      margin-bottom: 14px;
      gap: 8px;
    }
    .tb-card-title {
      font-size: 9px;
      letter-spacing: 0.06em;
    }
    .tb-card-icon-wrap {
      width: 32px;
      height: 32px;
    }
    .tb-card-icon {
      width: 15px;
      height: 15px;
    }
    .tb-card-custom-img {
      width: 16px;
      height: 16px;
    }
    .tb-card-custom-svg {
      width: 15px;
      height: 15px;
    }
    .tb-card-item-title {
      font-size: 7.5px;
      letter-spacing: 0.02em;
    }
  }
{% endstylesheet %}
