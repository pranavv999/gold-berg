{% doc %}
  Renders a full-screen media lightbox modal on product pages matching reference design.

  @param {object} product - The Shopify product object
{% enddoc %}

{%- assign lightbox_images = product.media | where: "media_type", "image" -%}
{%- assign lightbox_count = lightbox_images.size -%}

{%- if lightbox_count > 0 -%}
<div id="ProductMediaLightbox" class="product-media-lightbox-overlay" aria-hidden="true" role="dialog" aria-modal="true">
  <!-- TOP HEADER ROW -->
  <div class="lightbox-header">
    <div class="lightbox-title-group">
      <span class="lightbox-product-title">{{ product.title | escape | upcase }}</span>
      <span class="lightbox-image-counter" id="LightboxCounter">1 OF {{ lightbox_count }}</span>
    </div>
    
    <button type="button" class="lightbox-close-btn" id="LightboxCloseBtn" aria-label="Close Lightbox">
      <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- CENTER MEDIA STAGE -->
  <div class="lightbox-stage-wrapper">
    <button type="button" class="lightbox-nav-arrow lightbox-nav-prev" id="LightboxPrevBtn" aria-label="Previous image">
      <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="lightbox-image-container" id="LightboxImageContainer">
      <img id="LightboxMainImage" src="{{ lightbox_images.first | image_url: width: 1800 }}" alt="{{ product.title | escape }}" loading="eager">
    </div>

    <button type="button" class="lightbox-nav-arrow lightbox-nav-next" id="LightboxNextBtn" aria-label="Next image">
      <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  <!-- BOTTOM DOT INDICATOR BAR -->
  <div class="lightbox-footer">
    <div class="lightbox-dots-container" id="LightboxDotsContainer">
      {%- for img in lightbox_images -%}
        <button type="button" class="lightbox-dot{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to image {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  /* LIGHTBOX OVERLAY CORE STYLES */
  .product-media-lightbox-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    width: 100dvw;
    height: 100vh;
    height: 100dvh;
    height: -webkit-fill-available;
    background: #000000;
    background-color: #000000;
    z-index: 999999999;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    box-sizing: border-box;
    overflow: hidden;
  }

  .product-media-lightbox-overlay.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* TOP HEADER ROW */
  .lightbox-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px 32px 12px 32px;
    z-index: 10;
    width: 100%;
    box-sizing: border-box;
    flex-shrink: 0;
  }

  .lightbox-title-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .lightbox-product-title {
    font-family: var(--font-body-family), -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 11px;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .lightbox-image-counter {
    font-family: var(--font-body-family), -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 10px;
    font-weight: 500;
    color: #8e8e93;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  /* TOP RIGHT CLOSE BUTTON */
  .lightbox-close-btn {
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    margin: 0;
    transition: background 0.2s ease, transform 0.2s ease;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .lightbox-close-btn:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: scale(1.08);
  }

  /* CENTER MEDIA STAGE */
  .lightbox-stage-wrapper {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-height: calc(100dvh - 160px);
    padding: 0 16px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .lightbox-image-container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    max-width: 90vw;
    max-height: 75vh;
    max-height: 75dvh;
  }

  .lightbox-image-container img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    border-radius: 4px;
    transition: opacity 0.2s ease;
  }

  /* NAV ARROWS (DESKTOP HOVER) */
  .lightbox-nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    opacity: 0;
    transition: opacity 0.2s ease, background 0.2s ease;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .lightbox-stage-wrapper:hover .lightbox-nav-arrow {
    opacity: 1;
  }

  .lightbox-nav-arrow:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .lightbox-nav-prev {
    left: 24px;
  }

  .lightbox-nav-next {
    right: 24px;
  }

  /* BOTTOM FOOTER & DOT INDICATORS (MATCHING ZICABELLA.COM) */
  .lightbox-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 16px 16px max(32px, env(safe-area-inset-bottom)) 16px;
    z-index: 10;
    width: 100%;
    box-sizing: border-box;
    flex-shrink: 0;
  }

  .lightbox-dots-container {
    display: flex;
    align-items: center;
    gap: 6px;
    background: transparent !important;
    padding: 0 !important;
    border-radius: 0 !important;
    border: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    box-shadow: none !important;
    max-width: 90vw;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .lightbox-dots-container::-webkit-scrollbar {
    display: none;
  }

  .lightbox-dot {
    width: 4px;
    height: 4px;
    min-width: 4px;
    min-height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    transition: background 0.3s ease, width 0.3s ease, border-radius 0.3s ease;
  }

  .lightbox-dot.active {
    background: #ffffff;
    width: 18px;
    border-radius: 4px;
  }

  /* MOBILE RESPONSIVE ADJUSTMENTS */
  @media screen and (max-width: 749px) {
    .lightbox-header {
      padding: 16px 20px 8px 20px;
    }

    .lightbox-product-title {
      font-size: 10px;
    }

    .lightbox-image-counter {
      font-size: 9px;
    }

    .lightbox-close-btn {
      width: 32px;
      height: 32px;
      min-width: 32px;
      min-height: 32px;
    }

    .lightbox-nav-arrow {
      display: none !important;
    }

    .lightbox-stage-wrapper {
      max-height: calc(100dvh - 140px);
      padding: 0 8px;
    }

    .lightbox-image-container {
      max-width: 96vw;
      max-height: 68dvh;
    }

    .lightbox-footer {
      padding: 12px 16px max(36px, calc(16px + env(safe-area-inset-bottom))) 16px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const lightbox = document.getElementById('ProductMediaLightbox');
    if (!lightbox) return;

    const mainImage = document.getElementById('LightboxMainImage');
    const counter = document.getElementById('LightboxCounter');
    const closeBtn = document.getElementById('LightboxCloseBtn');
    const prevBtn = document.getElementById('LightboxPrevBtn');
    const nextBtn = document.getElementById('LightboxNextBtn');
    const dotsContainer = document.getElementById('LightboxDotsContainer');
    const dots = dotsContainer ? dotsContainer.querySelectorAll('.lightbox-dot') : [];
    
    // IMAGE DATASET FROM LIQUID
    const mediaImages = [
      {%- for img in lightbox_images -%}
        "{{ img | image_url: width: 1800 }}"{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ];

    const totalCount = mediaImages.length;
    let currentIndex = 0;
    let touchStartX = 0;
    let touchEndX = 0;

    function openLightbox(index) {
      currentIndex = (index >= 0 && index < totalCount) ? index : 0;
      updateLightboxState();
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function updateLightboxState() {
      if (!mediaImages[currentIndex]) return;

      // Update Main Image
      mainImage.style.opacity = '0.4';
      mainImage.src = mediaImages[currentIndex];
      mainImage.onload = function() {
        mainImage.style.opacity = '1';
      };

      // Update Counter
      if (counter) {
        counter.textContent = `${currentIndex + 1} OF ${totalCount}`;
      }

      // Update Dots
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });

      // Preload Next/Prev Images
      preloadImage((currentIndex + 1) % totalCount);
      preloadImage((currentIndex - 1 + totalCount) % totalCount);
    }

    function preloadImage(idx) {
      if (mediaImages[idx]) {
        const img = new Image();
        img.src = mediaImages[idx];
      }
    }

    function nextImage() {
      currentIndex = (currentIndex + 1) % totalCount;
      updateLightboxState();
    }

    function prevImage() {
      currentIndex = (currentIndex - 1 + totalCount) % totalCount;
      updateLightboxState();
    }

    // CLICK EVENT DELEGATION FOR ALL PRODUCT GALLERY IMAGES
    document.addEventListener('click', function (e) {
      const slide = e.target.closest('.media-slide, .mobile-media-slide, .product__media-item, [data-lightbox-trigger]');
      if (slide) {
        let index = parseInt(slide.getAttribute('data-lightbox-index'), 10);
        if (isNaN(index)) {
          // Fallback: calculate index from position among siblings or images
          const allSlides = Array.from(document.querySelectorAll('.media-slide, .mobile-media-slide, .product__media-item'));
          index = allSlides.indexOf(slide);
          if (index < 0) index = 0;
          if (index >= totalCount) index = index % totalCount;
        }
        openLightbox(index);
      }
    });

    // CLOSE BUTTON & OVERLAY CLICK
    if (closeBtn) {
      closeBtn.addEventListener('click', closeLightbox);
    }

    lightbox.addEventListener('click', function (e) {
      if (e.target === lightbox || e.target.classList.contains('lightbox-stage-wrapper') || e.target.classList.contains('lightbox-image-container')) {
        closeLightbox();
      }
    });

    // ARROW NAVIGATION
    if (prevBtn) prevBtn.addEventListener('click', function(e) { e.stopPropagation(); prevImage(); });
    if (nextBtn) nextBtn.addEventListener('click', function(e) { e.stopPropagation(); nextImage(); });

    // DOT CLICK NAVIGATION
    dots.forEach((dot) => {
      dot.addEventListener('click', function (e) {
        e.stopPropagation();
        const idx = parseInt(this.getAttribute('data-index'), 10);
        if (!isNaN(idx)) {
          currentIndex = idx;
          updateLightboxState();
        }
      });
    });

    // KEYBOARD LISTENERS
    document.addEventListener('keydown', function (e) {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') nextImage();
      if (e.key === 'ArrowLeft') prevImage();
    });

    // TOUCH SWIPE FOR MOBILE
    lightbox.addEventListener('touchstart', function (e) {
      if (!lightbox.classList.contains('active')) return;
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    lightbox.addEventListener('touchend', function (e) {
      if (!lightbox.classList.contains('active')) return;
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });

    function handleSwipe() {
      const swipeDistance = touchEndX - touchStartX;
      if (Math.abs(swipeDistance) > 40) {
        if (swipeDistance < 0) {
          nextImage();
        } else {
          prevImage();
        }
      }
    }
  });
</script>
{%- endif -%}
